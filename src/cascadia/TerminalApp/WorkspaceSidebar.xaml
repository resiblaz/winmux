<ContentPresenter x:Class="TerminalApp.WorkspaceSidebar"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="using:TerminalApp"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:mtu="using:Microsoft.Terminal.UI"
                  mc:Ignorable="d">

    <ContentPresenter.Resources>
        <Style x:Key="ExpandedWorkspaceItemContainerStyle"
               TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Margin" Value="8,3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="CollapsedWorkspaceItemContainerStyle"
               TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <DataTemplate x:Key="ExpandedWorkspaceTemplate"
                      x:DataType="local:WorkspaceItemViewModel">
            <Grid MinHeight="72"
                  Padding="10,6,6,6"
                  AutomationProperties.HelpText="{x:Bind StatusText, Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <IconSourceElement Width="16"
                                   Height="16"
                                   VerticalAlignment="Center"
                                   IconSource="{x:Bind mtu:IconPathConverter.IconSourceWUX(Icon), Mode=OneWay}" />
                <StackPanel Grid.Column="1"
                            Margin="8,0,4,0"
                            VerticalAlignment="Center"
                            Spacing="3">
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Text="{x:Bind Title, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Consolas"
                                   FontSize="11"
                                   Opacity="0.72"
                                   Text="{x:Bind WorkingDirectoryDisplay, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind WorkingDirectory, Mode=OneWay}"
                                   Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(WorkingDirectoryDisplay), Mode=OneWay}" />
                        <TextBlock Grid.Column="1"
                                   MaxWidth="104"
                                   Margin="8,0,0,0"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Opacity="0.72"
                                   Text="{x:Bind GitBranch, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind GitRepositoryRoot, Mode=OneWay}"
                                   Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(GitBranch), Mode=OneWay}" />
                    </Grid>
                    <TextBlock FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{ThemeResource AttentionPaneBorderColor}"
                               Text="{x:Bind LatestNotification, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(LatestNotification), Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <Border Padding="6,1"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(StatusText), Mode=OneWay}">
                            <TextBlock FontSize="10"
                                       Opacity="0.88"
                                       Text="{x:Bind StatusText, Mode=OneWay}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Opacity="0.72"
                                   Text="{x:Bind SwitchShortcutText, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SwitchShortcutText), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2"
                        Height="24"
                        MinWidth="24"
                        Margin="2"
                        Padding="5,0"
                        AutomationProperties.Name="{x:Bind NotificationAutomationName, Mode=OneWay}"
                        Background="{ThemeResource AttentionPaneBorderColor}"
                        BorderThickness="0"
                        Click="_Notification_Click"
                        Content="{x:Bind UnreadBadgeText, Mode=OneWay}"
                        CornerRadius="12"
                        FontSize="11"
                        Foreground="{ThemeResource AttentionPaneForegroundBrush}"
                        IsTabStop="False"
                        Tag="{Binding}"
                        Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(UnreadBadgeText), Mode=OneWay}" />
                <Button Grid.Column="3"
                        Width="28"
                        Height="28"
                        Padding="0"
                        AutomationProperties.Name="{x:Bind PinAutomationName, Mode=OneWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="_Pin_Click"
                        Content="{x:Bind PinIconGlyph, Mode=OneWay}"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="12"
                        IsTabStop="False"
                        Tag="{Binding}" />
                <Button x:Uid="WorkspaceSidebarCloseButton"
                        Grid.Column="4"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="_Close_Click"
                        Content="&#xE711;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="10"
                        IsTabStop="False"
                        Tag="{Binding}" />

                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarOpenNotificationMenuItem"
                                        Click="_Notification_Click"
                                        IsEnabled="{x:Bind mtu:Converters.StringNotEmpty(UnreadBadgeText), Mode=OneWay}"
                                        Tag="{Binding}" />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarMarkNotificationsReadMenuItem"
                                        Click="_MarkNotificationsRead_Click"
                                        IsEnabled="{x:Bind mtu:Converters.StringNotEmpty(UnreadBadgeText), Mode=OneWay}"
                                        Tag="{Binding}" />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarClearNotificationHistoryMenuItem"
                                        Click="_ClearNotificationHistory_Click"
                                        IsEnabled="{x:Bind mtu:Converters.StringNotEmpty(NotificationHistoryCountText), Mode=OneWay}"
                                        Tag="{Binding}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarConfigureAgentResumeMenuItem"
                                        Click="_ConfigureAgentResume_Click"
                                        Tag="{Binding}" />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarResumeAgentMenuItem"
                                        Click="_ResumeAgent_Click"
                                        IsEnabled="{x:Bind HasAgentResume, Mode=OneWay}"
                                        Tag="{Binding}" />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarClearAgentResumeMenuItem"
                                        Click="_ClearAgentResume_Click"
                                        IsEnabled="{x:Bind HasAgentResume, Mode=OneWay}"
                                        Tag="{Binding}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="_Pin_Click"
                                        Tag="{Binding}"
                                        Text="{x:Bind PinActionText, Mode=OneWay}" />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarRenameMenuItem"
                                        Click="_Rename_Click"
                                        Tag="{Binding}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarCloseMenuItem"
                                        Click="_Close_Click"
                                        Tag="{Binding}" />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarCloseOthersMenuItem"
                                        Click="_CloseOthers_Click"
                                        Tag="{Binding}" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CollapsedWorkspaceTemplate"
                      x:DataType="local:WorkspaceItemViewModel">
            <Grid MinHeight="36"
                  AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <IconSourceElement Width="16"
                                   Height="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IconSource="{x:Bind mtu:IconPathConverter.IconSourceWUX(Icon), Mode=OneWay}" />
                <Button Height="18"
                        MinWidth="18"
                        Padding="3,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{x:Bind NotificationAutomationName, Mode=OneWay}"
                        Background="{ThemeResource AttentionPaneBorderColor}"
                        BorderThickness="0"
                        Click="_Notification_Click"
                        Content="{x:Bind UnreadBadgeText, Mode=OneWay}"
                        CornerRadius="9"
                        FontSize="9"
                        Foreground="{ThemeResource AttentionPaneForegroundBrush}"
                        IsTabStop="False"
                        Tag="{Binding}"
                        Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(UnreadBadgeText), Mode=OneWay}" />
                <ToolTipService.ToolTip>
                    <ToolTip Content="{x:Bind Title, Mode=OneWay}" />
                </ToolTipService.ToolTip>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarOpenNotificationMenuItem"
                                        Click="_Notification_Click"
                                        IsEnabled="{x:Bind mtu:Converters.StringNotEmpty(UnreadBadgeText), Mode=OneWay}"
                                        Tag="{Binding}" />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarMarkNotificationsReadMenuItem"
                                        Click="_MarkNotificationsRead_Click"
                                        IsEnabled="{x:Bind mtu:Converters.StringNotEmpty(UnreadBadgeText), Mode=OneWay}"
                                        Tag="{Binding}" />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarClearNotificationHistoryMenuItem"
                                        Click="_ClearNotificationHistory_Click"
                                        IsEnabled="{x:Bind mtu:Converters.StringNotEmpty(NotificationHistoryCountText), Mode=OneWay}"
                                        Tag="{Binding}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarConfigureAgentResumeMenuItem"
                                        Click="_ConfigureAgentResume_Click"
                                        Tag="{Binding}" />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarResumeAgentMenuItem"
                                        Click="_ResumeAgent_Click"
                                        IsEnabled="{x:Bind HasAgentResume, Mode=OneWay}"
                                        Tag="{Binding}" />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarClearAgentResumeMenuItem"
                                        Click="_ClearAgentResume_Click"
                                        IsEnabled="{x:Bind HasAgentResume, Mode=OneWay}"
                                        Tag="{Binding}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="_Pin_Click"
                                        Tag="{Binding}"
                                        Text="{x:Bind PinActionText, Mode=OneWay}" />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarRenameMenuItem"
                                        Click="_Rename_Click"
                                        Tag="{Binding}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarCloseMenuItem"
                                        Click="_Close_Click"
                                        Tag="{Binding}" />
                        <MenuFlyoutItem x:Uid="WorkspaceSidebarCloseOthersMenuItem"
                                        Click="_CloseOthers_Click"
                                        Tag="{Binding}" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
            </Grid>
        </DataTemplate>
    </ContentPresenter.Resources>

    <Border Background="{ThemeResource TabViewBackground}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SidebarTitle"
                           x:Uid="WorkspaceSidebarTitle"
                           Grid.Column="0"
                           Margin="12,0,4,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Opacity="0.72"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="NotificationCenterButton"
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Margin="0,4"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0">
                    <Grid Width="24"
                          Height="24">
                        <FontIcon HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="13"
                                  Glyph="&#xEA8F;" />
                        <Border x:Name="NotificationCenterBadge"
                                Height="14"
                                MinWidth="14"
                                Padding="3,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AttentionPaneBorderColor}"
                                CornerRadius="7"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <TextBlock x:Name="NotificationCenterBadgeText"
                                       VerticalAlignment="Center"
                                       FontSize="8"
                                       Foreground="{ThemeResource AttentionPaneForegroundBrush}" />
                        </Border>
                    </Grid>
                    <Button.Flyout>
                        <Flyout x:Name="NotificationCenterFlyout"
                                Opening="_NotificationCenter_Opening"
                                Placement="Right">
                            <Grid Width="360"
                                  MinHeight="180"
                                  MaxHeight="520">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Uid="WorkspaceSidebarNotificationCenterTitle"
                                           Margin="4,2,4,10"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <ListView x:Name="NotificationHistoryList"
                                          Grid.Row="1"
                                          MaxHeight="380"
                                          IsItemClickEnabled="True"
                                          ItemClick="_NotificationHistory_ItemClick"
                                          ItemsSource="{x:Bind NotificationHistory, Mode=OneWay}"
                                          KeyDown="_NotificationHistory_KeyDown"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:WorkspaceNotification">
                                            <Grid Width="320"
                                                  Padding="8"
                                                  AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7"
                                                         Height="7"
                                                         Margin="0,6,0,0"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Top"
                                                         Fill="{ThemeResource AttentionPaneBorderColor}"
                                                         Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(IsRead), Mode=OneWay}" />
                                                <StackPanel Grid.Column="1"
                                                            Spacing="2">
                                                    <TextBlock FontSize="11"
                                                               Opacity="0.65"
                                                               Text="{x:Bind WorkspaceTitle, Mode=OneWay}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{x:Bind Title, Mode=OneWay}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock MaxLines="2"
                                                               Opacity="0.85"
                                                               Text="{x:Bind Message, Mode=OneWay}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Margin="8,2,0,0"
                                                           FontSize="10"
                                                           Opacity="0.6"
                                                           Text="{x:Bind TimestampText, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="NotificationCenterEmptyState"
                                           x:Uid="WorkspaceSidebarNotificationCenterEmptyState"
                                           Grid.Row="1"
                                           Margin="16,32"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.65" />
                                <StackPanel Grid.Row="2"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button x:Name="MarkAllNotificationsReadButton"
                                            x:Uid="WorkspaceSidebarMarkAllNotificationsReadButton"
                                            Click="_MarkAllNotificationsRead_Click" />
                                    <Button x:Name="ClearAllNotificationHistoryButton"
                                            x:Uid="WorkspaceSidebarClearAllNotificationHistoryButton"
                                            Click="_ClearAllNotificationHistory_Click" />
                                </StackPanel>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ToggleButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Margin="4"
                        Padding="0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="_Toggle_Click"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}" />
            </Grid>

            <ListView x:Name="WorkspaceList"
                      x:Uid="WorkspaceSidebarList"
                      Grid.Row="1"
                      Grid.Column="0"
                      AllowDrop="True"
                      Background="Transparent"
                      BorderThickness="0"
                      CanDragItems="True"
                      CanReorderItems="True"
                      IsSwipeEnabled="False"
                      ItemContainerStyle="{StaticResource ExpandedWorkspaceItemContainerStyle}"
                      ItemTemplate="{StaticResource ExpandedWorkspaceTemplate}"
                      KeyDown="_WorkspaceList_KeyDown"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionMode="Single">
                <ListView.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected"
                                                 Color="#0A84FF" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver"
                                                 Color="#0A84FF" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed"
                                                 Color="#0A84FF" />
                                <SolidColorBrush x:Key="ListViewItemForegroundSelected"
                                                 Color="White" />
                                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver"
                                                 Color="White" />
                                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed"
                                                 Color="White" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected"
                                                 Color="#0A84FF" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver"
                                                 Color="#0A84FF" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed"
                                                 Color="#0A84FF" />
                                <SolidColorBrush x:Key="ListViewItemForegroundSelected"
                                                 Color="White" />
                                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver"
                                                 Color="White" />
                                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed"
                                                 Color="White" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected"
                                                 Color="{ThemeResource SystemColorHighlightColor}" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver"
                                                 Color="{ThemeResource SystemColorHighlightColor}" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed"
                                                 Color="{ThemeResource SystemColorHighlightColor}" />
                                <SolidColorBrush x:Key="ListViewItemForegroundSelected"
                                                 Color="{ThemeResource SystemColorHighlightTextColor}" />
                                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver"
                                                 Color="{ThemeResource SystemColorHighlightTextColor}" />
                                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed"
                                                 Color="{ThemeResource SystemColorHighlightTextColor}" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </ListView.Resources>
            </ListView>

            <Button x:Name="NewButton"
                    x:Uid="WorkspaceSidebarNewButton"
                    Grid.Row="2"
                    Grid.Column="0"
                    Height="36"
                    Margin="8,6"
                    Padding="10,0"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="_New_Click">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="12"
                              Glyph="&#xE710;" />
                    <TextBlock x:Name="NewButtonText"
                               x:Uid="WorkspaceSidebarNewButtonText"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Thumb x:Name="ResizeHandle"
                   x:Uid="WorkspaceSidebarResizeHandle"
                   Grid.RowSpan="3"
                   Grid.Column="1"
                   MinWidth="0"
                   AutomationProperties.AutomationId="WorkspaceSidebarResizeHandle"
                   Background="Transparent"
                   DragDelta="_Resize_DragDelta"
                   IsTabStop="True"
                   PreviewKeyDown="_Resize_PreviewKeyDown">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="{TemplateBinding Background}">
                            <Border Width="1"
                                    HorizontalAlignment="Right"
                                    Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="WorkspaceSidebarResizeToolTip" />
                </ToolTipService.ToolTip>
            </Thumb>
        </Grid>
    </Border>
</ContentPresenter>
