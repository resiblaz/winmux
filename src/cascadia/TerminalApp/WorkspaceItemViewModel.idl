import "Tab.idl";
import "WorkspaceNotification.idl";

namespace TerminalApp
{
    runtimeclass WorkspaceItemViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        WorkspaceItemViewModel(Tab tab);

        Guid WorkspaceId { get; };
        Tab SourceTab { get; };
        String Title { get; };
        String Icon { get; };
        Boolean IsPinned { get; set; };
        String PinIconGlyph { get; };
        String PinActionText { get; };
        String PinAutomationName { get; };
        String SwitchShortcutText { get; };
        String UnreadBadgeText { get; };
        String NotificationAutomationName { get; };
        WorkspaceNotification LatestUnreadNotification { get; };
        Windows.Foundation.Collections.IObservableVector<WorkspaceNotification> Notifications { get; };

        void AddNotification(UInt32 paneId, String title, String message);
        void ClearNotifications();
        void ClearNotificationsForPane(UInt32 paneId);

        Boolean IsSelected;
        UInt32 UnreadCount;
        String WorkingDirectory;
        String StatusText;
        String LatestNotification;
    }
}
