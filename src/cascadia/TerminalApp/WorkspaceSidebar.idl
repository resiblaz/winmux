import "WorkspaceItemViewModel.idl";
import "WorkspaceNotification.idl";

namespace TerminalApp
{
    [default_interface] runtimeclass WorkspaceSidebar : Windows.UI.Xaml.Controls.ContentPresenter,
                                                         Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        WorkspaceSidebar();

        Windows.UI.Xaml.Controls.ListView WorkspaceList { get; };
        Windows.Foundation.Collections.IObservableVector<WorkspaceNotification> NotificationHistory { get; };
        Boolean IsExpanded { get; set; };
        Double ExpandedWidth { get; set; };
        void RefreshNotifications();

        event Windows.Foundation.TypedEventHandler<WorkspaceSidebar, WorkspaceItemViewModel> PinRequested;
        event Windows.Foundation.TypedEventHandler<WorkspaceSidebar, WorkspaceItemViewModel> CloseRequested;
        event Windows.Foundation.TypedEventHandler<WorkspaceSidebar, WorkspaceItemViewModel> CloseOthersRequested;
        event Windows.Foundation.TypedEventHandler<WorkspaceSidebar, WorkspaceItemViewModel> RenameRequested;
        event Windows.Foundation.TypedEventHandler<WorkspaceSidebar, WorkspaceItemViewModel> ConfigureAgentResumeRequested;
        event Windows.Foundation.TypedEventHandler<WorkspaceSidebar, WorkspaceItemViewModel> ResumeAgentRequested;
        event Windows.Foundation.TypedEventHandler<WorkspaceSidebar, WorkspaceItemViewModel> ClearAgentResumeRequested;
        event Windows.Foundation.TypedEventHandler<WorkspaceSidebar, WorkspaceItemViewModel> ActivateNotificationRequested;
        event Windows.Foundation.TypedEventHandler<WorkspaceSidebar, WorkspaceNotification> ActivateNotificationItemRequested;
        event Windows.Foundation.TypedEventHandler<WorkspaceSidebar, WorkspaceItemViewModel> MarkNotificationsReadRequested;
        event Windows.Foundation.TypedEventHandler<WorkspaceSidebar, WorkspaceItemViewModel> ClearNotificationHistoryRequested;
        event Windows.Foundation.TypedEventHandler<WorkspaceSidebar, Object> MarkAllNotificationsReadRequested;
        event Windows.Foundation.TypedEventHandler<WorkspaceSidebar, Object> ClearAllNotificationHistoryRequested;
    }
}
