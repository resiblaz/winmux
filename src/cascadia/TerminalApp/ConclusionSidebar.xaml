<ContentPresenter x:Class="TerminalApp.ConclusionSidebar"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="using:TerminalApp"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:mtu="using:Microsoft.Terminal.UI"
                  RequestedTheme="Dark"
                  mc:Ignorable="d">

    <ContentPresenter.Resources>
        <Style x:Key="ConclusionListItemStyle"
               TargetType="ListViewItem">
            <Setter Property="Margin" Value="10,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <DataTemplate x:Key="HistoryItemTemplate"
                      x:DataType="local:AgentHistoryItem">
            <Border Padding="12,10"
                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}"
                    Background="{ThemeResource WorkspaceChromeStatusFillBrush}"
                    BorderBrush="{ThemeResource WorkspaceChromeDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{x:Bind Title, Mode=OneTime}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <Border Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource WorkspaceChromeAccentBrush}"
                                CornerRadius="5"
                                Visibility="{x:Bind mtu:Converters.BooleanToVisibility(IsPinned), Mode=OneTime}">
                            <TextBlock x:Uid="ConclusionSidebarPinnedBadge"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource WorkspaceChromeSelectedForegroundBrush}" />
                        </Border>
                    </Grid>

                    <StackPanel Spacing="3">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Opacity="0.76"
                                   Text="{x:Bind WorkspaceTitle, Mode=OneTime}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind Cwd, Mode=OneTime}" />
                        <TextBlock FontFamily="Consolas"
                                   FontSize="10"
                                   Opacity="0.62"
                                   Text="{x:Bind SessionLabel, Mode=OneTime}"
                                   TextTrimming="CharacterEllipsis" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Consolas"
                                       FontSize="10"
                                       Opacity="0.58"
                                       Text="{x:Bind TimestampText, Mode=OneTime}" />
                            <Border Grid.Column="1"
                                    MaxWidth="116"
                                    Margin="8,0,0,0"
                                    Padding="5,1"
                                    Background="{ThemeResource WorkspaceChromeSurfaceBrush}"
                                    CornerRadius="5"
                                    Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(Model), Mode=OneTime}">
                                <TextBlock FontFamily="Consolas"
                                           FontSize="9"
                                           Opacity="0.72"
                                           Text="{x:Bind Model, Mode=OneTime}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Border Padding="9,7"
                            Background="{ThemeResource WorkspaceChromeSurfaceBrush}"
                            CornerRadius="6"
                            Visibility="{x:Bind mtu:Converters.BooleanToVisibility(HasPrompt), Mode=OneTime}">
                        <StackPanel Spacing="3">
                            <TextBlock x:Uid="ConclusionSidebarPromptLabel"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Opacity="0.52" />
                            <TextBlock FontSize="11"
                                       IsTextSelectionEnabled="True"
                                       Opacity="0.76"
                                       Text="{x:Bind Prompt, Mode=OneTime}"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <local:ConclusionMarkdownView HorizontalContentAlignment="Stretch"
                                                  Markdown="{x:Bind Message, Mode=OneTime}"
                                                  Opacity="0.78" />

                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="4">
                        <Button x:Uid="ConclusionSidebarPinButton"
                                Width="30"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="_Pin_Click"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="11"
                                Tag="{Binding}"
                                Content="&#xE840;" />
                        <Button x:Uid="ConclusionSidebarCopyButton"
                                Width="30"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="_Copy_Click"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="11"
                                Tag="{Binding}"
                                Content="&#xE8C8;" />
                        <Button x:Uid="ConclusionSidebarDeleteButton"
                                Width="30"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="_Delete_Click"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="11"
                                Tag="{Binding}"
                                Content="&#xE74D;" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SessionSummaryTemplate"
                      x:DataType="local:AgentHistoryItem">
            <Border Padding="12,10"
                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}"
                    Background="{ThemeResource WorkspaceChromeStatusFillBrush}"
                    BorderBrush="{ThemeResource WorkspaceChromeDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{x:Bind Title, Mode=OneTime}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <Border Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource WorkspaceChromeAccentBrush}"
                                CornerRadius="5"
                                Visibility="{x:Bind mtu:Converters.BooleanToVisibility(HasLocalTurns), Mode=OneTime}">
                            <TextBlock x:Uid="ConclusionSidebarSessionLocalBadge"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource WorkspaceChromeSelectedForegroundBrush}" />
                        </Border>
                    </Grid>

                    <TextBlock MaxLines="3"
                               FontSize="11"
                               IsTextSelectionEnabled="True"
                               Opacity="0.76"
                               Text="{x:Bind Message, Mode=OneTime}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="WrapWholeWords"
                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(Message), Mode=OneTime}" />

                    <StackPanel Spacing="3">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Opacity="0.72"
                                   Text="{x:Bind WorkspaceTitle, Mode=OneTime}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontFamily="Consolas"
                                   FontSize="10"
                                   Opacity="0.58"
                                   Text="{x:Bind Cwd, Mode=OneTime}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind Cwd, Mode=OneTime}"
                                   Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(Cwd), Mode=OneTime}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="7">
                                <TextBlock FontFamily="Consolas"
                                           FontSize="10"
                                           Opacity="0.62"
                                           Text="{x:Bind SessionLabel, Mode=OneTime}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="10"
                                           Opacity="0.52"
                                           Text="{x:Bind SourceKind, Mode=OneTime}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SourceKind), Mode=OneTime}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       Opacity="0.58"
                                       Text="{x:Bind TimestampText, Mode=OneTime}" />
                        </Grid>
                        <Border MaxWidth="150"
                                Padding="5,1"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource WorkspaceChromeSurfaceBrush}"
                                CornerRadius="5"
                                Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(Model), Mode=OneTime}">
                            <TextBlock FontFamily="Consolas"
                                       FontSize="9"
                                       Opacity="0.72"
                                       Text="{x:Bind Model, Mode=OneTime}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </ContentPresenter.Resources>

    <Border x:Name="RootBorder"
            Background="{ThemeResource WorkspaceChromeSurfaceBrush}"
            BorderBrush="{ThemeResource WorkspaceChromeDividerBrush}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid x:Name="ExpandedContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid MinHeight="58"
                      Padding="14,8,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <TextBlock x:Uid="ConclusionSidebarTitle"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="WorkspaceNameText"
                                   FontSize="11"
                                   Opacity="0.56"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="HeaderToggleButton"
                            Grid.Column="1"
                            Width="34"
                            Height="34"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="_Toggle_Click"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="12" />
                </Grid>

                <Pivot x:Name="SidebarTabs"
                       Grid.Row="1">
                    <PivotItem x:Name="ConclusionsTab">
                        <PivotItem.Header>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="7">
                                <TextBlock x:Uid="ConclusionSidebarHistoryTab"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                                <Border x:Name="CountBadge"
                                        MinWidth="20"
                                        Height="18"
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource WorkspaceChromeAccentBrush}"
                                        CornerRadius="9"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="CountText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource WorkspaceChromeSelectedForegroundBrush}" />
                                </Border>
                            </StackPanel>
                        </PivotItem.Header>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="10,0,10,6"
                                        Spacing="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="CurrentWorkspaceRadio"
                                                 x:Uid="ConclusionSidebarCurrentScope"
                                                 Grid.Column="0"
                                                 HorizontalAlignment="Stretch"
                                                 HorizontalContentAlignment="Center"
                                                 Click="_Scope_Click"
                                                 GroupName="HistoryScope"
                                                 IsChecked="True" />
                                    <RadioButton x:Name="AllWorkspacesRadio"
                                                 x:Uid="ConclusionSidebarAllScope"
                                                 Grid.Column="1"
                                                 HorizontalAlignment="Stretch"
                                                 HorizontalContentAlignment="Center"
                                                 Click="_Scope_Click"
                                                 GroupName="HistoryScope" />
                                </Grid>
                                <TextBox x:Name="HistorySearchBox"
                                         x:Uid="ConclusionSidebarSearchBox"
                                         Height="32"
                                         Padding="8,3"
                                         TextChanged="_Search_TextChanged" />
                                <Grid ColumnSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SessionFilterBox"
                                             x:Uid="ConclusionSidebarSessionFilterBox"
                                             Height="32"
                                             Padding="8,3"
                                             TextChanged="_SessionFilter_TextChanged" />
                                    <ComboBox x:Name="DateFilterBox"
                                              x:Uid="ConclusionSidebarDateFilterBox"
                                              Grid.Column="1"
                                              MinWidth="104"
                                              SelectedIndex="0"
                                              SelectionChanged="_DateFilter_SelectionChanged">
                                        <ComboBoxItem x:Uid="ConclusionSidebarDateFilterAll" />
                                        <ComboBoxItem x:Uid="ConclusionSidebarDateFilterDay" />
                                        <ComboBoxItem x:Uid="ConclusionSidebarDateFilterWeek" />
                                        <ComboBoxItem x:Uid="ConclusionSidebarDateFilterMonth" />
                                    </ComboBox>
                                </Grid>
                                <Button x:Name="ClearHistoryButton"
                                        x:Uid="ConclusionSidebarClearHistoryButton"
                                        HorizontalAlignment="Right"
                                        Click="_ClearHistory_Click"
                                        Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>

                            <ListView x:Name="HistoryList"
                                      Grid.Row="1"
                                      ItemsSource="{x:Bind HistoryItems, Mode=OneWay}"
                                      ItemContainerStyle="{StaticResource ConclusionListItemStyle}"
                                      ItemTemplate="{StaticResource HistoryItemTemplate}"
                                      SelectionMode="None"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" />

                            <StackPanel x:Name="EmptyState"
                                        Grid.Row="1"
                                        MaxWidth="220"
                                        Margin="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="9">
                                <Border Width="44"
                                        Height="44"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource WorkspaceChromeStatusFillBrush}"
                                        CornerRadius="22">
                                    <FontIcon HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="18"
                                              Glyph="&#xE8A5;"
                                              Opacity="0.72" />
                                </Border>
                                <TextBlock x:Uid="ConclusionSidebarEmptyHistoryTitle"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Uid="ConclusionSidebarEmptyHistoryBody"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           LineHeight="18"
                                           Opacity="0.62"
                                           TextAlignment="Center"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Name="SessionsTab">
                        <PivotItem.Header>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="7">
                                <TextBlock x:Uid="ConclusionSidebarSessionsTab"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                                <Border x:Name="SessionCountBadge"
                                        MinWidth="20"
                                        Height="18"
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource WorkspaceChromeAccentBrush}"
                                        CornerRadius="9"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="SessionCountText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource WorkspaceChromeSelectedForegroundBrush}" />
                                </Border>
                            </StackPanel>
                        </PivotItem.Header>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="10,0,10,7"
                                        Spacing="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock x:Name="SessionWorkspaceTitleText"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.74"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ActiveWorkspaceCwdText"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   Opacity="0.55"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button x:Name="SyncSessionsButton"
                                            x:Uid="ConclusionSidebarSyncSessionsButton"
                                            Grid.Column="1"
                                            MinWidth="68"
                                            Height="30"
                                            Margin="8,0,0,0"
                                            Padding="10,2"
                                            Click="_SyncSessions_Click" />
                                </Grid>

                                <Border Padding="8,5"
                                        Background="{ThemeResource WorkspaceChromeStatusFillBrush}"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="7">
                                        <ProgressRing x:Name="SessionProgressRing"
                                                      Width="14"
                                                      Height="14"
                                                      VerticalAlignment="Center"
                                                      IsActive="False"
                                                      Visibility="Collapsed" />
                                        <TextBlock x:Name="SessionStatusText"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Opacity="0.68"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>

                                <TextBox x:Name="SessionSearchBox"
                                         x:Uid="ConclusionSidebarSessionSearchBox"
                                         Height="32"
                                         Padding="8,3"
                                         TextChanged="_SessionSearch_TextChanged" />
                            </StackPanel>

                            <ListView x:Name="SessionList"
                                      Grid.Row="1"
                                      ItemsSource="{x:Bind SessionItems, Mode=OneWay}"
                                      ItemContainerStyle="{StaticResource ConclusionListItemStyle}"
                                      ItemTemplate="{StaticResource SessionSummaryTemplate}"
                                      SelectionChanged="_SessionSelection_Changed"
                                      SelectionMode="Single"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" />

                            <StackPanel x:Name="EmptySessionsState"
                                        Grid.Row="1"
                                        MaxWidth="220"
                                        Margin="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="9">
                                <Border Width="44"
                                        Height="44"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource WorkspaceChromeStatusFillBrush}"
                                        CornerRadius="22">
                                    <FontIcon HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="18"
                                              Glyph="&#xE8D4;"
                                              Opacity="0.72" />
                                </Border>
                                <TextBlock x:Uid="ConclusionSidebarEmptySessionsTitle"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Uid="ConclusionSidebarEmptySessionsBody"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           LineHeight="18"
                                           Opacity="0.62"
                                           TextAlignment="Center"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <Grid Grid.Row="2"
                                  Margin="10,7,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LoadSessionButton"
                                        x:Uid="ConclusionSidebarLoadSessionButton"
                                        Grid.Column="0"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        HorizontalAlignment="Stretch"
                                        Click="_LoadSession_Click"
                                        IsEnabled="False" />
                                <Button x:Name="ResumeSessionButton"
                                        x:Uid="ConclusionSidebarResumeSessionButton"
                                        Grid.Column="1"
                                        Height="32"
                                        Margin="4,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        Click="_ResumeSession_Click"
                                        IsEnabled="False" />
                            </Grid>
                        </Grid>
                    </PivotItem>
                </Pivot>

                <Border Grid.Row="2"
                        MinHeight="34"
                        Padding="14,6"
                        BorderBrush="{ThemeResource WorkspaceChromeDividerBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal"
                                Spacing="7">
                        <Ellipse Width="6"
                                 Height="6"
                                 VerticalAlignment="Center"
                                 Fill="{ThemeResource WorkspaceChromeAccentBrush}" />
                        <TextBlock x:Uid="ConclusionSidebarPersistentHistoryStatus"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Opacity="0.58" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="CompactRail"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button x:Name="RailToggleButton"
                        Width="40"
                        Height="40"
                        Margin="4,8,4,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="_Toggle_Click"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="12" />
                <TextBlock Grid.Row="1"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontFamily="{ThemeResource SymbolThemeFontFamily}"
                           FontSize="15"
                           Opacity="0.72"
                           Text="&#xE8A5;" />
            </Grid>
        </Grid>
    </Border>
</ContentPresenter>
