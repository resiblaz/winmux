<UserControl x:Class="TerminalApp.TaskDetailsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mtu="using:Microsoft.Terminal.UI"
             d:DesignHeight="720"
             d:DesignWidth="960"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="TaskCardStyle"
               TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource WorkspaceChromeSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceChromeDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="TaskSectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceChromeTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <DataTemplate x:Key="TaskDetailsTemplate"
                      x:DataType="local:TaskItemViewModel">
            <ScrollViewer HorizontalContentAlignment="Stretch"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="1280"
                      HorizontalAlignment="Stretch"
                      Padding="28,24,28,48">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="CompactDetails">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="DetailsAside.Visibility" Value="Collapsed" />
                                    <Setter Target="DetailsAsideColumn.Width" Value="0" />
                                    <Setter Target="InlineRunDetails.Visibility" Value="Visible" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="WideDetails">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="1120" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="DetailsAside.Visibility" Value="Visible" />
                                    <Setter Target="DetailsAsideColumn.Width" Value="290" />
                                    <Setter Target="InlineRunDetails.Visibility" Value="Collapsed" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition x:Name="DetailsAsideColumn" Width="290" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="16">
                        <StackPanel Spacing="7">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <TextBlock Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Text="{x:Bind Id, Mode=OneTime}" />
                                <Border Padding="7,2"
                                        Background="{ThemeResource WorkspaceChromeStatusFillBrush}"
                                        CornerRadius="9">
                                    <TextBlock Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}"
                                               FontSize="11"
                                               Text="{x:Bind StatusLabel, Mode=OneTime}" />
                                </Border>
                                <TextBlock Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}"
                                           FontSize="11"
                                           Text="{x:Bind PriorityLabel, Mode=OneTime}" />
                            </StackPanel>
                            <TextBlock Foreground="{ThemeResource WorkspaceChromeTextPrimaryBrush}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind Title, Mode=OneTime}"
                                       TextWrapping="Wrap" />
                            <TextBlock Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}"
                                       FontSize="12"
                                       Text="{x:Bind AcceptanceSummary, Mode=OneTime}" />
                        <TextBlock Text="{x:Bind AgentSummary, Mode=OneTime}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" />
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <Button x:Name="ConfigureTaskAgentButton" x:Uid="AgentConfigureTask" Click="_ConfigureAgent_Click"
                                        IsEnabled="{x:Bind CanConfigureAgent, Mode=OneTime}" />
                                <Button x:Uid="TaskPageStartTaskButton" Click="_StartTask_Click"
                                        Visibility="{x:Bind mtu:Converters.BooleanToVisibility(CanStart), Mode=OneTime}" />
                                <Button x:Uid="TaskPageStopTaskButton" Click="_StopTask_Click"
                                        Visibility="{x:Bind mtu:Converters.BooleanToVisibility(CanStop), Mode=OneTime}" />
                                <Button x:Uid="TaskPageOpenTerminalButton" Click="_OpenTerminal_Click"
                                        Visibility="{x:Bind mtu:Converters.BooleanToVisibility(CanOpenTerminal), Mode=OneTime}" />
                                <Button x:Uid="TaskPageCloseTaskButton" Click="_CloseTask_Click"
                                        Visibility="{x:Bind mtu:Converters.BooleanToVisibility(CanCloseTerminal), Mode=OneTime}" />
                                <Button x:Uid="TaskPageMarkDoneButton" Click="_MarkDone_Click"
                                        Visibility="{x:Bind mtu:Converters.BooleanToVisibility(CanMarkDone), Mode=OneTime}" />
                                <Button x:Uid="TaskPageReopenTaskButton" Click="_ReopenTask_Click"
                                        Visibility="{x:Bind mtu:Converters.BooleanToVisibility(CanReopen), Mode=OneTime}" />
                                <Button x:Uid="TaskPageRetryTaskButton" Click="_RetryTask_Click"
                                        Visibility="{x:Bind mtu:Converters.BooleanToVisibility(CanRetry), Mode=OneTime}" />
                                <Button x:Uid="TaskPageCancelTaskButton" Click="_CancelTask_Click"
                                        Visibility="{x:Bind mtu:Converters.BooleanToVisibility(CanCancel), Mode=OneTime}" />
                                <Button x:Uid="TaskPageFinalizeWorktreeButton" Click="_FinalizeWorktree_Click"
                                        Visibility="{x:Bind mtu:Converters.BooleanToVisibility(CanFinalizeWorktree), Mode=OneTime}" />
                                <Button x:Uid="TaskPageDeleteTaskButton" Click="_DeleteTask_Click"
                                        Visibility="{x:Bind mtu:Converters.BooleanToVisibility(CanDelete), Mode=OneTime}" />
                            </StackPanel>
                        </ScrollViewer>

                        <Border Style="{StaticResource TaskCardStyle}"
                                Visibility="{x:Bind mtu:Converters.BooleanToVisibility(HasActiveRun), Mode=OneTime}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing Width="16" Height="16" IsActive="True" />
                                    <TextBlock x:Uid="TaskPageActiveRunTitle"
                                               Foreground="{ThemeResource WorkspaceChromeTextPrimaryBrush}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}"
                                           Text="{x:Bind ActiveRunSummary, Mode=OneTime}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource TaskCardStyle}">
                            <StackPanel>
                                <TextBlock x:Uid="TaskPageGoalTitle" Style="{StaticResource TaskSectionTitleStyle}" />
                                <TextBlock Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}"
                                           LineHeight="22"
                                           Text="{x:Bind Description, Mode=OneTime}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource TaskCardStyle}"
                                Visibility="{x:Bind mtu:Converters.BooleanToVisibility(HasQueuedMessages), Mode=OneTime}">
                            <StackPanel>
                                <TextBlock x:Uid="TaskPageQueuedMessagesTitle" Style="{StaticResource TaskSectionTitleStyle}" />
                                <ListView x:Name="QueuedMessagesList"
                                          ItemsSource="{x:Bind QueuedMessageItems, Mode=OneTime}"
                                          SelectionMode="Single"
                                          SelectionChanged="_QueuedMessages_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,3" Padding="10"
                                                    Background="{ThemeResource WorkspaceChromeStatusFillBrush}"
                                                    CornerRadius="6">
                                                <TextBlock Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}"
                                                           Text="{Binding}"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBox x:Name="QueuedMessageEditor"
                                         x:Uid="TaskPageQueuedMessageEditor"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button x:Name="EditQueuedMessageButton"
                                            x:Uid="TaskPageEditQueuedMessageButton"
                                            IsEnabled="False"
                                            Click="_EditQueuedMessage_Click" />
                                    <Button x:Name="RemoveQueuedMessageButton"
                                            x:Uid="TaskPageRemoveQueuedMessageButton"
                                            IsEnabled="False"
                                            Click="_RemoveQueuedMessage_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="InlineRunDetails"
                                Style="{StaticResource TaskCardStyle}"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Uid="TaskPageRunDetailsTitle" Style="{StaticResource TaskSectionTitleStyle}" />
                                <ItemsControl ItemsSource="{x:Bind RunDetailItems, Mode=OneTime}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,4"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}"
                                                       Text="{Binding}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Uid="TaskPageRunDetailsEmpty"
                                           Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}"
                                           Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(HasRunDetails), Mode=OneTime}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource TaskCardStyle}">
                            <StackPanel>
                                <TextBlock x:Uid="TaskPageAcceptanceTitle" Style="{StaticResource TaskSectionTitleStyle}" />
                                <ItemsControl ItemsSource="{x:Bind AcceptanceItems, Mode=OneTime}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,4"
                                                       Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}"
                                                       Text="{Binding}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource TaskCardStyle}"
                                Visibility="{x:Bind mtu:Converters.BooleanToVisibility(HasResult), Mode=OneTime}">
                            <StackPanel>
                                <TextBlock x:Uid="TaskPageResultTitle" Style="{StaticResource TaskSectionTitleStyle}" />
                                <TextBlock Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}"
                                           Text="{x:Bind Result, Mode=OneTime}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource TaskCardStyle}">
                            <StackPanel>
                                <TextBlock x:Uid="TaskPageExecutionLogTitle" Style="{StaticResource TaskSectionTitleStyle}" />
                                <ItemsControl ItemsSource="{x:Bind RunItems, Mode=OneTime}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border MinHeight="42" Padding="0,8"
                                                    BorderBrush="{ThemeResource WorkspaceChromeDividerBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <TextBlock Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}"
                                                           Text="{Binding}"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <StackPanel x:Name="DetailsAside"
                                Grid.Column="2"
                                Spacing="16">
                        <Border Style="{StaticResource TaskCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="TaskPagePropertiesTitle" Style="{StaticResource TaskSectionTitleStyle}" />
                                <TextBlock x:Uid="TaskPageWorkspaceProperty" Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" />
                                <TextBlock Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" Text="{x:Bind Workspace, Mode=OneTime}" TextWrapping="Wrap" />
                                <TextBlock x:Uid="TaskPageExecutionModeProperty" Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" />
                                <TextBlock Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" Text="{x:Bind ExecutionMode, Mode=OneTime}" TextWrapping="Wrap" />
                                <TextBlock x:Uid="TaskPageTerminalProperty" Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" />
                                <TextBlock Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" Text="{x:Bind TerminalLabel, Mode=OneTime}" />
                                <TextBlock x:Uid="TaskPageWorktreeProperty" Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" />
                                <TextBlock Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" Text="{x:Bind Worktree, Mode=OneTime}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                <TextBlock x:Uid="TaskPageBranchProperty" Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" />
                                <TextBlock Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" Text="{x:Bind Branch, Mode=OneTime}" TextWrapping="Wrap" />
                                <TextBlock x:Uid="TaskPageDirectoryProperty" Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" />
                                <TextBlock Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" Text="{x:Bind WorkingDirectory, Mode=OneTime}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TaskCardStyle}">
                            <StackPanel>
                                <TextBlock x:Uid="TaskPageRunDetailsTitle" Style="{StaticResource TaskSectionTitleStyle}" />
                                <ScrollViewer MaxHeight="420"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{x:Bind RunDetailItems, Mode=OneTime}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,4"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}"
                                                           Text="{Binding}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Uid="TaskPageRunDetailsEmpty"
                                           Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}"
                                           Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(HasRunDetails), Mode=OneTime}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl x:Name="DetailsContentHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{x:Bind Task, Mode=OneWay}"
                    ContentTemplate="{StaticResource TaskDetailsTemplate}" />
        <Border x:Name="FollowupComposer" Grid.Row="1" Margin="16,0,16,12"
                Style="{StaticResource TaskCardStyle}" Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FollowupInput" x:Uid="TaskPageFollowupInput"
                         AcceptsReturn="True" IsSpellCheckEnabled="True" MinHeight="76" MaxHeight="160"
                         TextWrapping="Wrap" TextChanged="_FollowupInput_TextChanged" />
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Bottom">
                <Button x:Name="EditAcceptanceButton" x:Uid="TaskBoardEditAcceptance" Click="_EditAcceptance_Click" Visibility="Collapsed" />
                <Button x:Name="QueueFollowupButton" x:Uid="TaskPageQueueFollowupButton"
                        VerticalAlignment="Bottom" IsEnabled="False" Click="_QueueFollowup_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
