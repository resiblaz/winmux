<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Full-bleed deep obsidian background (adapts cleanly to any Android launcher mask) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="10"
                android:startY="0"
                android:endX="98"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#192030" />
                <item android:offset="1.0" android:color="#0B0E14" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft ambient celestial glow centered behind Dubhe star -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="74"
                android:centerY="44"
                android:gradientRadius="46"
                android:type="radial">
                <item android:offset="0.0" android:color="#523DDC97" />
                <item android:offset="0.48" android:color="#2E7AA2F7" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle orbital calibration ring -->
    <path
        android:pathData="M54,20a34,34 0 1,0 0,68a34,34 0 1,0 0,-68z"
        android:strokeColor="#14FFFFFF"
        android:strokeWidth="0.7" />

    <!-- Big Dipper constellation lines culminating at Dubhe (天枢) -->
    <path
        android:pathData="M24,67 L38,59 L51,62 L65,70 L74,44 L53,40 L51,62"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="68"
                android:endX="74"
                android:endY="44"
                android:type="linear">
                <item android:offset="0.0" android:color="#8064748B" />
                <item android:offset="0.55" android:color="#93C5FD" />
                <item android:offset="1.0" android:color="#3DDC97" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Supporting dipper stars -->
    <path android:fillColor="#94A3B8" android:pathData="M24,67m-2.1,0a2.1,2.1 0 1,0 4.2,0a2.1,2.1 0 1,0 -4.2,0" />
    <path android:fillColor="#CBD5E1" android:pathData="M38,59m-2.5,0a2.5,2.5 0 1,0 5.0,0a2.5,2.5 0 1,0 -5.0,0" />
    <path android:fillColor="#93C5FD" android:pathData="M51,62m-2.7,0a2.7,2.7 0 1,0 5.4,0a2.7,2.7 0 1,0 -5.4,0" />
    <path android:fillColor="#93C5FD" android:pathData="M65,70m-2.9,0a2.9,2.9 0 1,0 5.8,0a2.9,2.9 0 1,0 -5.8,0" />
    <path android:fillColor="#E2E8F0" android:pathData="M53,40m-3.0,0a3.0,3.0 0 1,0 6.0,0a3.0,3.0 0 1,0 -6.0,0" />

    <!-- Radiant Dubhe (天枢) 4-point primary star at (74, 44) -->
    <path android:pathData="M74,30 C75.3,39.5 78.5,42.7 88,44 C78.5,45.3 75.3,48.5 74,58 C72.7,48.5 69.5,45.3 60,44 C69.5,42.7 72.7,39.5 74,30 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="62"
                android:startY="32"
                android:endX="86"
                android:endY="56"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.5" android:color="#93C5FD" />
                <item android:offset="1.0" android:color="#3DDC97" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
