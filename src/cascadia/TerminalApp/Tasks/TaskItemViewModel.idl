namespace TerminalApp
{
    runtimeclass TaskItemViewModel
    {
        TaskItemViewModel();

        String Id { get; };
        String Workspace { get; };
        String Title { get; };
        String Description { get; };
        String StatusLabel { get; };
        String StatusGlyph { get; };
        String PriorityLabel { get; };
        String UpdatedLabel { get; };
        String AcceptanceSummary { get; };
        String ExecutionMode { get; };
        String AgentSummary { get; };
        String TerminalLabel { get; };
        String WorkingDirectory { get; };
        String Worktree { get; };
        String Branch { get; };
        String Result { get; };
        String ActiveRunSummary { get; };
        String AutomationName { get; };
        Boolean HasActiveRun { get; };
        Boolean HasResult { get; };
        Boolean HasQueuedMessages { get; };
        Boolean HasRunDetails { get; };
        Boolean CanStart { get; };
        Boolean CanStop { get; };
        Boolean CanOpenTerminal { get; };
        Boolean CanCloseTerminal { get; };
        Boolean CanMarkDone { get; };
        Boolean CanReopen { get; };
        Boolean CanRetry { get; };
        Boolean CanCancel { get; };
        Boolean CanFinalizeWorktree { get; };
        Boolean CanDelete { get; };
        Boolean CanConfigureAgent { get; };
        Windows.Foundation.Collections.IObservableVector<String> AcceptanceItems { get; };
        Windows.Foundation.Collections.IObservableVector<String> RunItems { get; };
        Windows.Foundation.Collections.IObservableVector<String> QueuedMessageItems { get; };
        Windows.Foundation.Collections.IObservableVector<String> RunDetailItems { get; };
        UInt64 Version { get; };
    }
}
