namespace TerminalApp
{
    runtimeclass AgentHistoryItem
    {
        AgentHistoryItem();

        Guid WorkspaceId { get; set; };
        String WorkspaceTitle { get; set; };
        String Provider { get; set; };
        String SessionId { get; set; };
        String TurnId { get; set; };
        String Cwd { get; set; };
        String Title { get; set; };
        String Prompt { get; set; };
        String Message { get; set; };
        String Model { get; set; };
        String SourceKind { get; set; };
        Windows.Foundation.DateTime Timestamp { get; set; };
        Boolean IsPinned { get; set; };
        Boolean IsSessionSummary { get; set; };
        Boolean CanLoad { get; set; };
        Boolean CanResume { get; set; };
        Boolean HasLocalTurns { get; set; };

        String TimestampText { get; };
        String SessionLabel { get; };
        Boolean HasPrompt { get; };
        String AutomationName { get; };
    }
}
