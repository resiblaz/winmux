<UserControl x:Class="TerminalApp.TaskBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:TerminalApp">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TaskBoardActiveBrush" Color="#9BC4FF" />
                    <SolidColorBrush x:Key="TaskBoardReviewBrush" Color="#E8BC77" />
                    <SolidColorBrush x:Key="TaskBoardDoneBrush" Color="#8AD0A7" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TaskBoardActiveBrush" Color="#9BC4FF" />
                    <SolidColorBrush x:Key="TaskBoardReviewBrush" Color="#E8BC77" />
                    <SolidColorBrush x:Key="TaskBoardDoneBrush" Color="#8AD0A7" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="TaskBoardActiveBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="TaskBoardReviewBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="TaskBoardDoneBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
            <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="WorkspaceChromeButtonHoverBrush" />
            <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="WorkspaceChromeButtonHoverBrush" />
            <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="WorkspaceChromeTextPrimaryBrush" />
            <DataTemplate x:Key="BoardCardTemplate" x:DataType="local:TaskItemViewModel">
                <Border x:Name="CardFrame" Margin="0,4" Padding="12,8,12,12" CornerRadius="7"
                        Background="{ThemeResource WorkspaceChromeSurfaceRaisedBrush}"
                        BorderBrush="{ThemeResource WorkspaceChromeDividerBrush}" BorderThickness="1"
                        Loaded="_Card_Loaded" DataContextChanged="_Card_DataContextChanged"
                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CardId" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind Id, Mode=OneTime}" />
                            <TextBlock Grid.Column="1" Text="⠿" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" IsHitTestVisible="False"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <Button x:Name="CardActions" Grid.Column="2" x:Uid="TaskBoardCardActions" Content="&#xE712;"
                                    Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="0" Background="Transparent" BorderThickness="0"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}" Tag="{x:Bind Id, Mode=OneTime}" Click="_CardActions_Click" />
                        </Grid>
                        <TextBlock Text="{x:Bind Title, Mode=OneTime}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource WorkspaceChromeTextPrimaryBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                        <Grid ColumnSpacing="7" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind PriorityLabel, Mode=OneTime}" FontSize="12" Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="·" Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" />
                            <TextBlock x:Name="CardAgent" Grid.Column="2" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" ToolTipService.ToolTip="{x:Bind AgentSummary, Mode=OneTime}" />
                        </Grid>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CardRunGlyph" FontSize="12" />
                            <TextBlock x:Name="CardRun" Grid.Column="1" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ActiveRunSummary, Mode=OneTime}" />
                        </Grid>
                        <TextBlock x:Name="CardProject" Text="{x:Bind Workspace, Mode=OneTime}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" Visibility="Collapsed" />
                        <StackPanel x:Name="CardPending" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <ProgressRing x:Name="CardPendingRing" Width="12" Height="12" IsActive="False" />
                            <TextBlock x:Uid="TaskBoardCardPending" FontSize="12" Foreground="{ThemeResource WorkspaceChromeAccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <Style x:Key="BoardCardContainerStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="BoardListStyle" TargetType="ListView">
                <Setter Property="ItemTemplate" Value="{StaticResource BoardCardTemplate}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource BoardCardContainerStyle}" />
                <Setter Property="SelectionMode" Value="Single" /><Setter Property="IsItemClickEnabled" Value="True" />
                <Setter Property="CanDragItems" Value="True" /><Setter Property="AllowDrop" Value="True" />
                <Setter Property="CanReorderItems" Value="False" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="BoardScroller" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
            <Grid x:Name="BoardColumns" Width="848" MinWidth="848" Margin="16,0,16,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="TodoColumn" Tag="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Padding="4"
                        AllowDrop="True" DragOver="_DragOver" DragLeave="_DragLeave" Drop="_Drop">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Margin="4,8,4,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="TodoGlyph" Text="○" Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" FontSize="14" />
                            <TextBlock x:Name="TodoHeading" Grid.Column="1" x:Uid="TaskBoardTodo" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="TodoCount" Grid.Column="2" FontSize="12" Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView x:Name="TodoList" Tag="1" Style="{StaticResource BoardListStyle}" ItemClick="_Card_ItemClick"
                                      DragItemsStarting="_DragItemsStarting" DragItemsCompleted="_DragItemsCompleted"
                                      DragOver="_DragOver" DragLeave="_DragLeave" Drop="_Drop" />
                            <Grid x:Name="TodoEmpty" Margin="0,4" MinHeight="108" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Rectangle x:Name="TodoEmptyOutline" Stroke="{ThemeResource WorkspaceChromeDividerBrush}" StrokeDashArray="3,3" RadiusX="7" RadiusY="7" />
                                <StackPanel Margin="12,20" Spacing="7"><TextBlock x:Name="TodoEmptyLabel" FontSize="13" TextAlignment="Center" Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" />
                                    <TextBlock x:Uid="TaskBoardEmptyTodoHint" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" /></StackPanel>
                            </Grid>
                        </Grid>
                        <Button x:Name="TodoMore" Grid.Row="2" x:Uid="TaskBoardLoadMore" Tag="1" Click="_LoadMore_Click" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <Border x:Name="DoingColumn" Grid.Column="1" Tag="2" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Padding="4"
                        AllowDrop="True" DragOver="_DragOver" DragLeave="_DragLeave" Drop="_Drop">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Margin="4,8,4,12" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DoingGlyph" Text="●" Foreground="{ThemeResource TaskBoardActiveBrush}" FontSize="14" />
                            <TextBlock x:Name="DoingHeading" Grid.Column="1" x:Uid="TaskBoardDoing" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="DoingCount" Grid.Column="2" FontSize="12" Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="BlockedHeading" Grid.Row="1" Margin="4,0,4,8" FontSize="12" Foreground="{ThemeResource TaskBoardReviewBrush}" />
                        <ListView x:Name="BlockedList" Tag="4" Grid.Row="2" Margin="0,0,0,8" Style="{StaticResource BoardListStyle}" MaxHeight="230"
                                  ItemClick="_Card_ItemClick" DragItemsStarting="_DragItemsStarting" DragItemsCompleted="_DragItemsCompleted"
                                  DragOver="_DragOver" DragLeave="_DragLeave" Drop="_Drop" />
                        <Grid Grid.Row="3">
                            <ListView x:Name="DoingList" Tag="2" Style="{StaticResource BoardListStyle}" ItemClick="_Card_ItemClick"
                                      DragItemsStarting="_DragItemsStarting" DragItemsCompleted="_DragItemsCompleted"
                                      DragOver="_DragOver" DragLeave="_DragLeave" Drop="_Drop" />
                            <Grid x:Name="DoingEmpty" Margin="0,4" MinHeight="108" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Rectangle Stroke="{ThemeResource WorkspaceChromeDividerBrush}" StrokeDashArray="3,3" RadiusX="7" RadiusY="7" />
                                <StackPanel Margin="12,20" Spacing="7"><TextBlock x:Name="DoingEmptyLabel" FontSize="13" TextAlignment="Center" Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" />
                                    <TextBlock x:Uid="TaskBoardEmptyDoingHint" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" /></StackPanel>
                            </Grid>
                        </Grid>
                        <Button x:Name="DoingMore" Grid.Row="4" Margin="0,8,0,0" x:Uid="TaskBoardLoadMore" Tag="2" Click="_LoadMore_Click" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <Border x:Name="ReviewColumn" Grid.Column="2" Tag="3" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Padding="4"
                        AllowDrop="True" DragOver="_DragOver" DragLeave="_DragLeave" Drop="_Drop">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Margin="4,8,4,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ReviewGlyph" Text="◇" Foreground="{ThemeResource TaskBoardReviewBrush}" FontSize="14" />
                            <TextBlock x:Name="ReviewHeading" Grid.Column="1" x:Uid="TaskBoardReview" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="ReviewCount" Grid.Column="2" FontSize="12" Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView x:Name="ReviewList" Tag="3" Style="{StaticResource BoardListStyle}" ItemClick="_Card_ItemClick"
                                      DragItemsStarting="_DragItemsStarting" DragItemsCompleted="_DragItemsCompleted"
                                      DragOver="_DragOver" DragLeave="_DragLeave" Drop="_Drop" />
                            <Grid x:Name="ReviewEmpty" Margin="0,4" MinHeight="108" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Rectangle Stroke="{ThemeResource WorkspaceChromeDividerBrush}" StrokeDashArray="3,3" RadiusX="7" RadiusY="7" />
                                <StackPanel Margin="12,20" Spacing="7"><TextBlock x:Name="ReviewEmptyLabel" FontSize="13" TextAlignment="Center" Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" />
                                    <TextBlock x:Uid="TaskBoardEmptyReviewHint" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" /></StackPanel>
                            </Grid>
                        </Grid>
                        <Button x:Name="ReviewMore" Grid.Row="2" x:Uid="TaskBoardLoadMore" Tag="3" Click="_LoadMore_Click" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <Border x:Name="DoneColumn" Grid.Column="3" Tag="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Padding="4"
                        AllowDrop="True" DragOver="_DragOver" DragLeave="_DragLeave" Drop="_Drop">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Margin="4,8,4,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DoneGlyph" Text="✓" Foreground="{ThemeResource TaskBoardDoneBrush}" FontSize="14" />
                            <TextBlock x:Name="DoneHeading" Grid.Column="1" x:Uid="TaskBoardDone" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="DoneCount" Grid.Column="2" FontSize="12" Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView x:Name="DoneList" Tag="5" Style="{StaticResource BoardListStyle}" ItemClick="_Card_ItemClick"
                                      DragItemsStarting="_DragItemsStarting" DragItemsCompleted="_DragItemsCompleted"
                                      DragOver="_DragOver" DragLeave="_DragLeave" Drop="_Drop" />
                            <Grid x:Name="DoneEmpty" Margin="0,4" MinHeight="108" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Rectangle Stroke="{ThemeResource WorkspaceChromeDividerBrush}" StrokeDashArray="3,3" RadiusX="7" RadiusY="7" />
                                <StackPanel Margin="12,20" Spacing="7"><TextBlock x:Name="DoneEmptyLabel" FontSize="13" TextAlignment="Center" Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" />
                                    <TextBlock x:Uid="TaskBoardEmptyDoneHint" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" /></StackPanel>
                            </Grid>
                        </Grid>
                        <Button x:Name="DoneMore" Grid.Row="2" x:Uid="TaskBoardLoadMore" Tag="5" Click="_LoadMore_Click" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <Canvas Grid.ColumnSpan="4" IsHitTestVisible="False">
                    <Border x:Name="DropMarker" Height="3" CornerRadius="2" Background="{ThemeResource WorkspaceChromeAccentBrush}" Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="20,3,20,8" Spacing="3" IsHitTestVisible="False">
            <TextBlock x:Name="HorizontalHint" x:Uid="TaskBoardHorizontalHint" FontSize="12" Foreground="{ThemeResource WorkspaceChromeTextTertiaryBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="DragFeedback" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceChromeTextSecondaryBrush}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</UserControl>
