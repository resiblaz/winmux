import "Tab.idl";
import "WorkspaceNotification.idl";

namespace TerminalApp
{
    runtimeclass WorkspaceItemViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        WorkspaceItemViewModel(Tab tab);

        Guid WorkspaceId { get; };
        Tab SourceTab { get; };
        Windows.Foundation.Collections.IObservableVector<Tab> Surfaces { get; };
        UInt32 SurfaceCount { get; };
        String SurfaceCountText { get; };
        Boolean HasMultipleSurfaces { get; };
        String Title { get; };
        String AutomationName { get; };
        String Icon { get; };
        Boolean IsPinned { get; set; };
        String PinIconGlyph { get; };
        String PinActionText { get; };
        String PinAutomationName { get; };
        String SwitchShortcutText { get; };
        String SwitchShortcutHintText { get; };
        String UnreadBadgeText { get; };
        String NotificationAutomationName { get; };
        UInt32 NotificationHistoryCount { get; };
        String NotificationHistoryCountText { get; };
        String WorkingDirectoryDisplay { get; };
        String ListeningPortsDisplay { get; };
        String ListeningPortsTooltip { get; };
        Boolean HasAgentResume { get; };
        String AgentResumeProvider { get; };
        String AgentResumeSessionId { get; };
        String AgentResumeWorkingDirectory { get; };
        WorkspaceNotification LatestUnreadNotification { get; };
        Windows.Foundation.Collections.IObservableVector<WorkspaceNotification> Notifications { get; };

        void AddNotification(Guid surfaceId, UInt32 paneId, String title, String message);
        void MarkAllNotificationsRead();
        void MarkNotificationsReadForPane(UInt32 paneId);
        void MarkNotificationsReadForSurfacePane(Guid surfaceId, UInt32 paneId);
        void ClearNotificationHistory();
        void ConfigureAgentResume(String provider, String sessionId, String workingDirectory);
        void ClearAgentResume();

        Boolean IsSelected;
        UInt32 UnreadCount;
        String WorkingDirectory;
        String GitBranch;
        String GitRepositoryRoot;
        Boolean IsGitBranchLoading;
        String StatusText;
        String LatestNotification;
    }
}
