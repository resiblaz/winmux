import "Tasks\\TaskItemViewModel.idl";

namespace TerminalApp
{
    runtimeclass TaskPageViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        TaskPageViewModel();

        Windows.Foundation.Collections.IObservableVector<TaskItemViewModel> Tasks { get; };
