namespace TerminalApp
{
    runtimeclass WorkspaceNotification
    {
        WorkspaceNotification(Guid workspaceId,
                              UInt32 paneId,
                              String workspaceTitle,
                              String title,
                              String message,
                              Windows.Foundation.DateTime timestamp);

        Guid NotificationId { get; };
        Guid WorkspaceId { get; };
        UInt32 PaneId { get; };
        String WorkspaceTitle { get; };
        String Title { get; };
        String Message { get; };
        Windows.Foundation.DateTime Timestamp { get; };
        String TimestampText { get; };
        Boolean IsRead { get; set; };
    }
}
