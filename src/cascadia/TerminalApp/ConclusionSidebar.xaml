<ContentPresenter x:Class="TerminalApp.ConclusionSidebar"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="using:TerminalApp"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  RequestedTheme="Dark"
                  mc:Ignorable="d">

    <ContentPresenter.Resources>
        <Style x:Key="ConclusionListItemStyle"
               TargetType="ListViewItem">
            <Setter Property="Margin" Value="10,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <DataTemplate x:Key="ConclusionItemTemplate"
                      x:DataType="local:WorkspaceNotification">
            <Border Padding="12,10"
                    AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                    Background="{ThemeResource WorkspaceChromeStatusFillBrush}"
                    BorderBrush="{ThemeResource WorkspaceChromeDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{x:Bind Title, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,1,0,0"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Opacity="0.58"
                                   Text="{x:Bind TimestampText, Mode=OneWay}" />
                    </Grid>
                    <TextBlock FontSize="12"
                               LineHeight="18"
                               MaxLines="8"
                               Opacity="0.78"
                               Text="{x:Bind Message, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="WrapWholeWords"
                               ToolTipService.ToolTip="{x:Bind Message, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </ContentPresenter.Resources>

    <Border Background="{ThemeResource WorkspaceChromeSurfaceBrush}"
            BorderBrush="{ThemeResource WorkspaceChromeDividerBrush}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid x:Name="ExpandedContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid MinHeight="58"
                      Padding="14,8,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <TextBlock x:Uid="ConclusionSidebarTitle"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="WorkspaceNameText"
                                   FontSize="11"
                                   Opacity="0.56"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="HeaderToggleButton"
                            Grid.Column="1"
                            Width="34"
                            Height="34"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="_Toggle_Click"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="12" />
                </Grid>

                <Pivot x:Name="SidebarTabs"
                       Grid.Row="1">
                    <PivotItem x:Name="ConclusionsTab">
                        <PivotItem.Header>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="7">
                                <TextBlock x:Uid="ConclusionSidebarConclusionsTab"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                                <Border x:Name="CountBadge"
                                        MinWidth="20"
                                        Height="18"
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource WorkspaceChromeAccentBrush}"
                                        CornerRadius="9"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="CountText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource WorkspaceChromeSelectedForegroundBrush}" />
                                </Border>
                            </StackPanel>
                        </PivotItem.Header>

                        <Grid>
                            <ListView x:Name="ConclusionList"
                                      ItemsSource="{x:Bind Conclusions, Mode=OneWay}"
                                      ItemContainerStyle="{StaticResource ConclusionListItemStyle}"
                                      ItemTemplate="{StaticResource ConclusionItemTemplate}"
                                      SelectionMode="None"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" />

                            <StackPanel x:Name="EmptyState"
                                        MaxWidth="220"
                                        Margin="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="9">
                                <Border Width="44"
                                        Height="44"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource WorkspaceChromeStatusFillBrush}"
                                        CornerRadius="22">
                                    <FontIcon HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="18"
                                              Glyph="&#xE8A5;"
                                              Opacity="0.72" />
                                </Border>
                                <TextBlock x:Uid="ConclusionSidebarEmptyTitle"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Uid="ConclusionSidebarEmptyBody"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           LineHeight="18"
                                           Opacity="0.62"
                                           TextAlignment="Center"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Grid>
                    </PivotItem>
                </Pivot>

                <Border Grid.Row="2"
                        MinHeight="34"
                        Padding="14,6"
                        BorderBrush="{ThemeResource WorkspaceChromeDividerBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal"
                                Spacing="7">
                        <Ellipse Width="6"
                                 Height="6"
                                 VerticalAlignment="Center"
                                 Fill="{ThemeResource WorkspaceChromeAccentBrush}" />
                        <TextBlock x:Uid="ConclusionSidebarLiveStatus"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Opacity="0.58" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="CompactRail"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button x:Name="RailToggleButton"
                        Width="40"
                        Height="40"
                        Margin="4,8,4,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="_Toggle_Click"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="12" />
                <TextBlock Grid.Row="1"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontFamily="{ThemeResource SymbolThemeFontFamily}"
                           FontSize="15"
                           Opacity="0.72"
                           Text="&#xE8A5;" />
            </Grid>
        </Grid>
    </Border>
</ContentPresenter>
